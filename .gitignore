# ============================================================
# Nowa-213R-N firmware dev repo - .gitignore
# ============================================================

# ---- Build toolchain (vendored upstream, ~183MB, not tracked) ----
# Obtain from atc1441/ATC_TLSR_Paper repo; needed locally to compile.
atc1441_src/Firmware/tc32_windows/
atc1441_src/Firmware/tc32_linux/

# ---- Build output (regenerated by build_firmware.py) ----
atc1441_src/Firmware/out/
atc1441_src/Firmware/ATC_Paper.bin
atc1441_src/Firmware/ATC_Paper.elf

# ---- Python caches ----
__pycache__/
*.pyc

# ---- Temp / verify readback files ----
verify_*.bin
TlsrComSwireWriter/verify_*.bin

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp

# ---- Corrupt factory backup (currently 0 bytes / lost) ----
# Re-create from another unit if factory restore is ever needed.
TlsrComSwireWriter/nowa213_original_backup.bin

# ---- EPD image tool generated previews / demo files ----
epd_preview/
*_demo.png

# ---- Rendered screen previews ----
# Regenerate: python tools/render_screen_preview.py --zoom 3
# The one image that is referenced by README.md is tracked separately as
# docs/images/screen-v12.0.png so the docs never depend on a build artefact.
previews/

# ---- Generated test image sets ----
# Regenerate: python tools/gen_epd_image.py  /  python tools/bmp2epd_framebuffer.py
# The BLE opcode sequence they emit (00 <fill> = memset, 01 = refresh) is
# documented in DEVELOPMENT.md instead of being committed as a file per size.
test_black_*.bmp
test_black_*.bin
test_black_*.h
test_black_*.txt
test_image.png

# ---- Failed FCC download ----
# This file is a Cloudflare "403 / enable JavaScript" page, not the datasheet.
# Kept on disk for reference; delete it if you re-download the real document.
fcc_internal.pdf

# ---- Upstream stray duplicate ----
# "Kopie" is German for "copy"; liblt_8258.a is the canonical library.
*Kopie*

# ---- Python virtualenvs ----
.venv/
venv/
