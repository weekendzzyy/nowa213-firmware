# ============================================================
# Nowa-213R-N firmware dev repo - .gitignore
# ============================================================

# ---- Build toolchain (vendored upstream, ~183MB, not tracked) ----
# Obtain from atc1441/ATC_TLSR_Paper repo; needed locally to compile.
atc1441_src/Firmware/tc32_windows/
atc1441_src/Firmware/tc32_linux/

# ---- Build output (regenerated by build_firmware.py) ----
atc1441_src/Firmware/out/
atc1441_src/Firmware/ATC_Paper.bin
atc1441_src/Firmware/ATC_Paper.elf

# ---- Python caches ----
__pycache__/
*.pyc

# ---- Temp / verify readback files ----
verify_*.bin
TlsrComSwireWriter/verify_*.bin

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp

# ---- Corrupt factory backup (currently 0 bytes / lost) ----
# Re-create from another unit if factory restore is ever needed.
TlsrComSwireWriter/nowa213_original_backup.bin
